{
  "$schema": "https://raw.githubusercontent.com/TheExeDEV/crater/main/schemas/crater.schema.json",

  "name": "funnydevz/funny-core",
  "version": "0.0.5",
  "description": "The object foundation for Roblox, which provides tools for creating games without spending time developing tools",
  "authors": ["IFMNB", "TheExeDEV"],
  "license": "MPLv2",
  "keywords": ["roblox", "core", "foundation", "library", "engine", "game-ready"],
  "repository": "https://github.com/FunnyDevz/funny-core",

  "registry": "crater",
  "registries": {},
  "can_publish": true,
  "import_to": "shared",

  "path_to_main": "",
  "path_to_definition_files": ["./src/core.d.luau"],
  "package_root": "build/package",
  "package_files": {
    "exclude": [
      "CI/**",
      ".github/**",
      "build/**",
      "src/temp/**",
      "**/__pycache__/**",
      "jest.config.json",
      "test.project.json"
    ],
    "allow": []
  },

  "vendor_packages": {
    "import_client": [
      "LINQ:luarocks#rocks/lualinq",
      "Quat:ifmnb/quat@0.0.1",
      "SAT:ifmnb/algo-sat@0.0.1",
      "Cryptography:wally#daily3014/cryptography@4.1.0",
      "BufferedArrays:ifmnb/buffer-array@0.0.1",
      "ifmnb/crate@0.0.1"
    ],
    "import_server": ["ProfileStore:wally#lm-loleris/profilestore@1.0.3"]
  },
  "import_client": [],
  "import_server": [],
  "import_develop": ["Jest:wally#roblox/jest@=3.20.0", "JestGlobals:wally#roblox/jest-globals@=3.20.0"],
  "overrides": [],

  "workspace": [],
  "scripts": {
    "prepack": "python3 build/prepack.py"
  },
  "tools": {
    "darklua": "seaofvoices/darklua@0.19.0",
    "stylua": "JohnnyMorganz/StyLua@2.6.0",
    "rojo": "rojo-rbx/rojo@7.7.1",
    "luau-lsp": "JohnnyMorganz/luau-lsp@1.70.1",
    "jest-roblox-cli": "christopher-buss/jest-roblox-cli@0.4.10"
  },
  "package_scripts": { "block": true, "allow": [] },

  "monorepository-elements": {},
  "interface": false,
  "realized_interfaces": []
}
