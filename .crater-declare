{
  "path_to_crater_settings": "crater.settings.json",
  "path_to_package_info": "crater.json",
  "api_version": 3,
  "features": {
    "dependencies": 1,
    "tools": 1,
    "scripts": 1,
    "workspaces": 1,
    "interfaces": 1,
    "monorepository": 2,
    "settings": 2,
    "package_rules": 3,
    "registry_names": 3
  },
  "schemas": {
    "package_info": "https://raw.githubusercontent.com/TheExeDEV/crater/main/schemas/crater.schema.json",
    "crater_settings": "https://raw.githubusercontent.com/TheExeDEV/crater/main/schemas/crater.settings.schema.json"
  },
  "registries": {
    "crater": "https://raw.githubusercontent.com/TheExeDEV/crater-registry/main",
    "wally": "https://github.com/UpliftGames/wally-index",
    "pesde": "https://github.com/pesde-pkg/index",
    "forest": "https://api.forest.dev",
    "ember": "https://github.com/ember-luau/index"
  },
  "realms": {
    "import_client": "client",
    "import_server": "server",
    "import_develop": "develop"
  },
  "dependency": {
    "pattern": "^(?:(?<alias>[A-Za-z][A-Za-z0-9_\\-]*):)?(?:(?<registry>[A-Za-z][A-Za-z0-9_\\-]*)#)?(?<scope>[a-z0-9_\\-]+)/(?<name>[a-z0-9_\\-]+)(?:(?<op>[=+^~])(?<ver>\\S*)|@(?<source>.+))?$",
    "operators": {
      "": "the newest version, the same as ^ alone",
      "^": "compatible: ^1.2.3 is >=1.2.3 <2.0.0, ^0.2.3 is >=0.2.3 <0.3.0",
      "~": "patch updates only: ~1.2.3 is >=1.2.3 <1.3.0",
      "=": "exactly this version",
      "+": "this version or newer: +1.2.3 is >=1.2.3",
      "@": "@1.2.3 is ^1.2.3; @=1.2.3, @~1.2.3, @+1.2.3 and @^1.2.3 use that operator"
    },
    "sources": {
      "@path:": "a local folder, relative to the package info",
      "@git+": "a git repository; #ref after the URL picks a tag, branch or commit"
    },
    "registry": "a dependency without registry# comes from the registry field of the package info"
  },
  "defaults": {
    "authors": [],
    "description": "",
    "license": "",
    "keywords": [],
    "repository": "",
    "registry": "crater",
    "registries": {},
    "can_publish": false,
    "import_to": "shared",
    "path_to_main": "",
    "icon": "",
    "path_to_definition_files": [],
    "package_files": {
      "exclude": [],
      "allow": []
    },
    "import_client": [],
    "import_server": [],
    "import_develop": [],
    "overrides": [],
    "workspace": [],
    "scripts": {},
    "tools": {},
    "package_scripts": {
      "block": false,
      "allow": []
    },
    "monorepository-elements": {},
    "interface": false,
    "realized_interfaces": [],
    "block_package_scripts": false,
    "allow_scripts_from": [],
    "exclude": [],
    "allow_files": []
  },
  "path_to_lock_file": "crater.lock",
  "cli": {
    "json_output": {
      "changelog": 1,
      "info": 1,
      "list": 1,
      "outdated": 1,
      "search": 1,
      "tags": 1
    }
  }
}
