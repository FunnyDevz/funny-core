#!/usr/bin/env fish

if not command -q gpp
    echo "required package gpp is not installed, abort"
    exit 1
end

set BUILD (dirname (realpath (status --current-filename)))
set ROOT (dirname "$BUILD")
set SOURCE "$ROOT/src"
set TARGET "$BUILD/target"

set defines
if test "$CI" = "true"; and test -n "$CORE_COMMIT"
    set defines "-DUNIQUE=\"$CORE_COMMIT\""
    echo "unique > $CORE_COMMIT"
else
    echo "unique > NON_PRODUCTION_BUILD (local build)"
end

set GPP_ARGS \
    -U "" "" "(" "," ")" "(" ")" "#" "" \
    -M "--#" "\n" " " " " "\n" "(" ")" \
    +cQQQ "--[[#" "]]"

set DEFINES (mktemp --suffix .gpp)
cat "$SOURCE/project.gpp" "$SOURCE/build.gpp" > "$DEFINES"

rm -rf "$TARGET"
mkdir -p "$TARGET"

for dir in (find "$SOURCE" -type d)
    mkdir -p "$TARGET"(string replace "$SOURCE" '' "$dir")
end

for file in (find "$SOURCE" -type f)
    set relative (string replace "$SOURCE/" '' "$file")
    set output "$TARGET/$relative"

    switch "$file"
        case '*.gpp'
            continue

        case '*.luau'
            echo "building > $relative"

            sed -E \
                -e 's/^[[:space:]]+--#/--#/' \
                -e 's/--\[\[#((if|ifdef|ifndef|elif) [^]]*|else|endif)\]\]/\n--#\1\n/g' \
                "$file" \
                | gpp $defines -I"$SOURCE" --include "$DEFINES" $GPP_ARGS -o "$output"

            if test $pipestatus[2] -ne 0
                echo "Error: failed to preprocess $relative"
                rm -f "$DEFINES"
                exit 1
            end

        case '*'
            cp "$file" "$output"
    end
end

rm -f "$DEFINES"
echo "builded, exit"
