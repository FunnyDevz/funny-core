```fish
#!/usr/bin/env fish

if not command -q gpp
    echo "required package gpp is not installed, abort"
    exit 1
end

set ROOT (dirname (status --current-filename))
set SOURCE "$ROOT/src"
set TARGET "$ROOT/target"

rm -rf "$TARGET"
mkdir -p "$TARGET"

for file in (find "$SOURCE" -type f -name '*.luau')
    set relative (string replace "$SOURCE/" '' "$file")
    set output "$TARGET/$relative"

    mkdir -p (dirname "$output")

    echo "building > $relative"

    gpp -M "--#" "\n" " " " " "\n" "(" ")" +cQ "--[[#" "]]" "$file" -o "$output"

    if test $status -ne 0
        echo "Error: failed to preprocess $relative"
        exit 1
    end
end

echo "builded, exit"