--[==[
    Статические константы для `extenison` части ядра, определяемые до момента билда. Они будут учитываться в
    работе функций и кода.
]==]
const extension = table.freeze {
    
    stderr = table.freeze {
    
        --[==[
            Лучше не выключать. Если это не будет включено, то функции вывода ошибок не будут их кидать без
            прямого `stdout:oute()`
        ]==]
        throw = true
    },

    stdout = table.freeze {
        --[==[
            Обычные операции вывода будут вызывать `out` с `debug.traceback()`. Это поведение не касается
            вывода `oute()` или других выводов, которые кидают ошибки.
        ]==]
        traceback = --[[#if DEBUG]] not --[[#endif]] true
    }
}

return extension